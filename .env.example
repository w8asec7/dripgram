# Public Firebase project configuration. Leave blank for explicit demo mode.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Firebase Storage is unused; private Supabase thumbnails do not require Blaze.
# Trusted backend only. Never use EXPO_PUBLIC_ for these values.
MODEL_API_KEY=
SERPAPI_API_KEY=

# Public backend URL only. Leave blank to derive the computer LAN host from Expo.
EXPO_PUBLIC_API_URL=
# Backend only. Standard model; Contributor mode is deliberately rejected.
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.2
META_MAX_OUTPUT_TOKENS=2400
META_REASONING_EFFORT=minimal
PROVIDER_TIMEOUT_MS=35000
MAX_META_CALLS_PER_DAY=100
MAX_SERP_CALLS_PER_DAY=60
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively configure the newer server key below; use one privileged key.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hackTx
PORT=3001
ALLOWED_WEB_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081

# Backend-only sponsored speech transcription; Standard mode only.
META_ASR_MODEL=muse-voice-transcribe-1.0
