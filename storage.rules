rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /users/{uid}/garments/{imageId} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
   allow delete: if request.auth != null && request.auth.uid == uid;
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
