{
  "name": "thread-wardrobe",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "demo": "expo start --offline",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server shared tests scripts --max-warnings=0",
    "format": "prettier --write src server shared tests scripts docs PHASE2_STATUS.md PHASE3_STATUS.md PIVOT_STATUS.md SOCIAL_FIRST_STATUS.md AGENTS.md README.md assets/LICENSE.md \"*.{json,js,cjs,ts}\"",
    "format:check": "prettier --check src server shared tests scripts docs PHASE2_STATUS.md PHASE3_STATUS.md PIVOT_STATUS.md SOCIAL_FIRST_STATUS.md AGENTS.md README.md assets/LICENSE.md \"*.{json,js,cjs,ts}\"",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns=unit",
    "test:integration": "jest --runInBand --testPathPatterns=integration",
    "test:ui": "jest --runInBand --testPathPatterns=ui",
    "test:e2e": "playwright test",
    "test:rules": "FIREBASE_EMULATORS_PATH=./.firebase/emulators firebase emulators:exec --only firestore,storage --project demo-thread \"jest --config jest.rules.config.cjs --runInBand\"",
    "export": "expo export --platform web",
    "backend": "tsx server/index.ts",
    "backend:dev": "tsx watch server/index.ts",
    "test:backend": "tsx --test server/tests/*.test.ts",
    "typecheck:backend": "tsc --noEmit -p server/tsconfig.json",
    "qa:security": "node scripts/check-environment.cjs",
    "qa:visual": "node scripts/capture-preview.cjs",
    "test:live": "tsx server/live-check.ts",
    "dev": "node scripts/dev.cjs",
    "preview:web": "node scripts/preview-web.cjs",
    "host:backend": "node scripts/host-backend.cjs",
    "publish:web": "node scripts/publish-web.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@fastify/cors": "^11.3.1",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "fastify": "^5.12.7",
    "firebase": "12.19.0",
    "jose": "^6.2.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "firebase-tools": "^14.27.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "lan-network": "^0.2.1",
    "prettier": "^3.9.10",
    "test-renderer": "^1.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "^1.13.6",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
